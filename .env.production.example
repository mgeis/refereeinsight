# Copy to .env.production and fill in real values.
# In AWS: store sensitive values in Secrets Manager or Parameter Store,
# then inject them as environment variables at deploy time.

# ── Database ──────────────────────────────────────────────────────────────────
# DB_SECRETS_SOURCE=env  → reads DATABASE_URL directly (dev/local)
# DB_SECRETS_SOURCE=aws  → fetches credentials from AWS Secrets Manager (test/prod)
DB_SECRETS_SOURCE=aws

# Required only when DB_SECRETS_SOURCE=aws:
# The ARN is preferred (stable across renames); the name is also accepted.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:referee-insight/prod/db-AbCdEf
# DB_SECRET_NAME=referee-insight/prod/db
# AWS_REGION=us-east-1

# Required only when DB_SECRETS_SOURCE=env:
# DATABASE_URL="postgresql://referee:<password>@<rds-endpoint>:5432/referee_reports?schema=public"

# ── Auth provider ─────────────────────────────────────────────────────────────
# "local"   → bcrypt + Session table
# "cognito" → AWS Cognito User Pool
AUTH_PROVIDER=local

# ── AWS Cognito (only when AUTH_PROVIDER=cognito) ─────────────────────────────
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── AI Insights ───────────────────────────────────────────────────────────────
# Required in production — the claude CLI is not available on the server.
# See src/app/api/insights/route.ts for switching from CLI → SDK.
ANTHROPIC_API_KEY=sk-ant-...
