# Copy to .env.production and fill in real values.
# In AWS: store sensitive values in Secrets Manager or Parameter Store,
# then inject them as environment variables at deploy time.

# ── Database ──────────────────────────────────────────────────────────────────
# DB_SECRETS_SOURCE=env  → reads DATABASE_URL directly (dev/local)
# DB_SECRETS_SOURCE=aws  → fetches credentials from AWS Secrets Manager (test/prod)
DB_SECRETS_SOURCE=aws

# Required only when DB_SECRETS_SOURCE=aws:
# The ARN is preferred (stable across renames); the name is also accepted.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:referee-insight/prod/db-AbCdEf
# DB_SECRET_NAME=referee-insight/prod/db
# AWS_REGION=us-east-1

# Required only when DB_SECRETS_SOURCE=env:
# DATABASE_URL="postgresql://referee:<password>@<rds-endpoint>:5432/referee_reports?schema=public"

# ── Auth provider ─────────────────────────────────────────────────────────────
# "local"   → bcrypt + Session table
# "cognito" → AWS Cognito User Pool
AUTH_PROVIDER=cognito

# ── AWS Cognito (only when AUTH_PROVIDER=cognito) ─────────────────────────────
# refereeinsight-prod pool — created but not yet seeded with any users; there's
# no live prod deployment to seed for yet. Strong password policy (12+ chars,
# upper/lower/number/symbol), unlike the relaxed test pool.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_5CEnPxD5c
COGNITO_CLIENT_ID=7k72rb5e2tt7755p6s82jgms8e

# ── AI Insights ───────────────────────────────────────────────────────────────
# Required in production — the claude CLI is not available on the server.
# See src/app/api/insights/route.ts for switching from CLI → SDK.
ANTHROPIC_API_KEY=sk-ant-...

# ── MCP server ────────────────────────────────────────────────────────────────
# No shared secret to configure — each user generates their own token from
# their profile page (Profile → MCP Access Tokens). Tokens are stored hashed
# in the database (McpToken table), scoped to that user's data/role.

# ── Event logging (CloudWatch) ────────────────────────────────────────────────
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/refereeinsight/prod/events

# ── Profile pictures (S3) ─────────────────────────────────────────────────────
# Private bucket (public access blocked, SSE-S3 encryption, versioning on) —
# pictures are served via short-lived presigned URLs, not a public bucket
# policy or CDN. Uses AWS_REGION above.
PROFILE_PICTURES_BUCKET=refereeinsight-prod-profile-pictures

# ── Outbound email (SES) ──────────────────────────────────────────────────────
# Used for admin-sent signup invites. Must be a verified SES sender identity;
# while the SES account is in sandbox mode, recipients must ALSO be verified
# (see TODO.md — SES production access is a manual AWS console request).
SES_FROM_EMAIL=no-reply@refereeinsight.com
